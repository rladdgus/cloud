# 필수: Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 선택: 무료 배경 사진 (https://www.pexels.com/api) - 없으면 그라데이션 배경을 사용
PEXELS_API_KEY=

# 선택: 텔레그램 알림 (BotFather로 봇을 만든 뒤 토큰/채팅 ID 입력)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 쇼핑 모드: Topview (https://www.topview.ai → 오른쪽 위 계정 → API Settings)
TOPVIEW_API_KEY=
TOPVIEW_UID=

# 쇼핑 모드: 쿠팡 파트너스 Open API (누적 판매 15만원 달성 후 발급, 없으면 products.txt 사용)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 자체 스튜디오: 제품 사진 → 움직이는 영상 (https://fal.ai → Dashboard → Keys)
FAL_KEY=

# 선택: 더 자연스러운 AI 음성 (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=
